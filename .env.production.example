# Copiar para .env.production (não versionado). Não reutilizar .env local.
NODE_ENV=production
APP_URL=https://redeconectacomunidade.com.br
DOMAIN=redeconectacomunidade.com.br
PAYLOAD_SECRET=
DATABASE_URL=postgresql://conecta:SENHA_CODIFICADA_EM_URL@postgres:5432/conecta_pilot
POSTGRES_USER=conecta
POSTGRES_PASSWORD=
POSTGRES_DB=conecta_pilot
# Diretórios absolutos distintos por ambiente. App roda com UID/GID 1000.
POSTGRES_HOST_DIR=/srv/conecta/pilot/postgres
MEDIA_HOST_DIR=/srv/conecta/pilot/media
MEDIA_DIR=/app/media
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=acesso@redeconectacomunidade.com.br
SMTP_PASSWORD=
SMTP_FROM=acesso@redeconectacomunidade.com.br
ALLOW_DEV_SEED=false
# Tag imutável por entrega; preservar a imagem anterior para recuperação.
APP_IMAGE=conecta-comunidade:m6
# Rede do Caddy existente na VPS masque-vps.
PROXY_NETWORK=masquebarbaridade_default
APP_NETWORK_ALIAS=conecta-app
